# /etc/fineco/enrichment.env  — OPTIONAL stock-enrichment + ETF market config.
#
# Read by the fineco-gateway unit (via its drop-in, with a leading `-` so it is
# optional). Install 0640 root:fineco-gateway. NEVER commit.
#
# Set BOTH the base and the host hash(es) to enable the market enrichment tools;
# with either absent the tools are simply disabled. The enrichment host is YOUR
# choice of a third-party data source — it is config-only and never shipped in
# this repo. Clients never supply a URL: the server only ever builds
# `<base>/stocks/<identifier>`, validates the host pin + path, and parses (never
# executes) the response.

# The scheme+host the server prepends to /stocks/<identifier> (https only):
FINECO_ENRICHMENT_BASE=https://<your-enrichment-host>

# App-layer host pin: the SHA-256 hex of the *normalized* (lowercased) host,
# comma-separated for multiple hosts. Derive it the way the binary does — e.g.
#   printf %s "$(echo -n '<your-enrichment-host>' | tr A-Z a-z)" | sha256sum
# (must match `normalized_host` in crates/fineco-market/src/source.rs; the
# enrichment tests show the exact derivation).
FINECO_ENRICHMENT_HOST_HASHES=<sha256-hex-of-host>

# Optional: override the zero-commission ETF list URL. Defaults to the fixed
# public Fineco endpoint, so only set this to point elsewhere.
# FINECO_ETF_URL=https://<your-etf-list-url>
