# /etc/fineco/cloudflared.env  — the Cloudflare Tunnel token (SECRET).
#
# Read by the cloudflared unit. Install 0600 root:root. NEVER commit.
#
# Create a *named tunnel* in the Cloudflare Zero Trust dashboard, route your
# public hostname to the gateway's loopback bind (service http://127.0.0.1:8799)
# with an HTTP Host Header rewrite to 127.0.0.1:8799 (see docs/SELF-HOSTING.md),
# then copy the tunnel's connector token below.
TUNNEL_TOKEN=<your-cloudflare-tunnel-token>
