# /etc/fineco/backup.env  — encrypted-backup config.
#
# Read by the fineco-backup unit/timer (which runs as User=fineco-store), so it
# must be group-readable by that user. Install 0640 root:fineco-store. NEVER commit.
# The age recipient is a PUBLIC key (not itself a secret) — but keep the matching
# PRIVATE key OFFLINE; it is the only thing that can decrypt your backups.
#
# Generate a keypair OFFLINE (on a machine that is NOT this host):
#   age-keygen -o key.txt      # prints the public recipient (age1...) to use here
FINECO_BACKUP_AGE_RECIPIENT=age1<your-public-recipient>

# Optional: where encrypted backups are written (default shown).
# FINECO_BACKUP_DIR=/var/backups/fineco-helper
