# /etc/fineco/private-worker.env  — the Fineco login credential (SECRET).
#
# Read ONLY by the fineco-private-worker unit (User=fineco-worker). Install as
#   install -m0640 -o root -g fineco-worker private-worker.env /etc/fineco/private-worker.env
# NEVER commit this file. The gateway and store-server users cannot read it.
#
# FINECO_USER_ID is your numeric Fineco "codice utente" (the login user code) —
# NOT your email. FINECO_PASSWORD is your Fineco web-login password.
#
# systemd's EnvironmentFile parser is NOT a shell: `$` and backtick are literal,
# but `\`, `"`, `'` and a leading `#`/`;` are special. A password with those will
# parse fine in most cases; if unsure, verify the delivered byte length matches
# (no Fineco call, leaks only a number):
#   systemd-run --quiet --wait --pipe -p EnvironmentFile=/etc/fineco/private-worker.env \
#     /bin/sh -c 'printf %s "$FINECO_PASSWORD" | wc -c'
FINECO_USER_ID=000000000
FINECO_PASSWORD=change-me
