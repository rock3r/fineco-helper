# /etc/fineco/access.env  — Cloudflare Access (client → gateway auth). REQUIRED.
#
# Read by the fineco-gateway unit (via its drop-in). Install 0640 root:fineco-gateway.
# NEVER commit. The gateway FAILS CLOSED: without a valid Access config it refuses
# to start — unless you set the loopback-only opt-out (FINECO_ACCESS_DISABLED=true),
# which disables client auth entirely and is ONLY safe for a same-host dev/test run.
#
# Set up: create a Cloudflare Access *self-hosted application* in front of your
# tunnel hostname, then fill these from its settings. The JWKS URL MUST be on the
# issuer's own origin (the verifier binds the key source to the issuer).
FINECO_ACCESS_ISSUER=https://<your-team>.cloudflareaccess.com
FINECO_ACCESS_AUDIENCE=<your-access-application-AUD-tag>
FINECO_ACCESS_JWKS_URL=https://<your-team>.cloudflareaccess.com/cdn-cgi/access/certs

# Pin the caller identity — REQUIRED when Access is enabled, set AT LEAST ONE.
# (Without a pin the gateway refuses to start: any token the Access policy admits
# would otherwise map to owner, so a later policy widening would grant ownership.)
# A token matching EITHER set pin maps to owner; set BOTH for dual-pin.
#  (a) Browser / IdP login or OAuth (an email identity — incl. ChatGPT/Claude
#      connectors via Cloudflare Access managed OAuth):
FINECO_OWNER_EMAIL=you@example.com
#  (b) Service token (non-interactive CLI clients): pin the token's Client ID:
# FINECO_ACCESS_OWNER_COMMON_NAME=<service-token-client-id>.access
#
# Dual-pin (recommended when you use BOTH connectors and CLI clients): set (a) AND
# (b) together — a token matching either is the owner. See docs/CONNECTORS.md.

# Connector tool scoping (requires an email/OAuth pin above; applies to any
# email-pinned deployment, incl. single-email-pin). The connector (email/OAuth)
# channel is restricted to a tool allowlist; the CLI (service-token) channel always
# gets every tool. UNSET = the default allowlist (every tool EXCEPT the four
# detailed-portfolio tools that expose absolute € values). Override:
#   FINECO_CONNECTOR_TOOLS="*"   (or "all")         -> no restriction (connectors get all)
#   FINECO_CONNECTOR_TOOLS="tool_a,tool_b,tool_c"   -> exactly those tools
# An unknown tool name fails closed at startup. See docs/CONNECTORS.md.
# FINECO_CONNECTOR_TOOLS=

# Origin allowlist (DNS-rebinding protection) — the legitimate client origin(s),
# comma-separated. Optional but recommended:
# FINECO_ALLOWED_ORIGINS=https://<your-mcp-client-origin>
