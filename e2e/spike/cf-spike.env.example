# Cloudflare Access spike — REAL-account configuration template.
#
# Copy to cf-spike.env (gitignored) and fill in from your Cloudflare Zero Trust
# dashboard. NEVER commit cf-spike.env and NEVER paste these values into chat or
# logs. The secrets below are credentials.

# --- Non-secret Access config (the gateway verifies tokens against these) ----
# Your Zero Trust team domain (Settings > Custom Pages shows the team name).
FINECO_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# The Access application's Application Audience (AUD) tag
# (Access > Applications > your app > Overview).
FINECO_ACCESS_AUDIENCE=<application-audience-aud-tag>
# The team JWKS (public keys) endpoint — always <team domain>/cdn-cgi/access/certs.
FINECO_ACCESS_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
# REQUIRED identity pin. Access maps a verified token to `owner` only if it matches;
# without a pin ANY admitted token would be owner. For this headless/service-token
# spike, pin the service token's COMMON_NAME — its Client ID, i.e. the same value as
# CF_ACCESS_CLIENT_ID below (the `<client-id>.access` string). (An email pin is wrong
# here: service-token JWTs carry no `email` claim.)
FINECO_ACCESS_OWNER_COMMON_NAME=<client-id>.access
# The public hostname your Tunnel ingress exposes (used by the verify probes).
SPIKE_PUBLIC_URL=https://<public-hostname>/
# Optional Origin allowlist (comma-separated). Leave EMPTY unless your client
# sends a known Origin header; an origin-less native MCP client passes regardless
# (the JWT is the real auth gate; Origin is only browser-DNS-rebinding defence).
FINECO_ALLOWED_ORIGINS=

# --- SECRET: Tunnel connector token (treat as a credential) ------------------
# Networks > Tunnels > your tunnel > Configure shows the connector token
# (the long string after `--token` in the install command).
TUNNEL_TOKEN=<tunnel-connector-token>

# --- SECRET: service token (used by your MCP CLIENT, not by any container) ---
# Access > Service Auth > Service Tokens. Your headless MCP client sends these
# two as the CF-Access-Client-Id / CF-Access-Client-Secret request headers; the
# spike does not feed them to a container.
CF_ACCESS_CLIENT_ID=<client-id>.access
CF_ACCESS_CLIENT_SECRET=<client-secret>
